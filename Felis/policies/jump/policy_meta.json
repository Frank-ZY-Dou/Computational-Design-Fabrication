{
  "policy": "Felis jump",
  "task": "loco",
  "network": {
    "actor_hidden_dims": [
      64,
      32
    ],
    "activation": "elu",
    "num_obs": 29,
    "num_actions": 6
  },
  "joint_names": [
    "waist_yaw",
    "waist_pitch",
    "hip_FR",
    "hip_FL",
    "hip_RL",
    "hip_RR"
  ],
  "default_dof_pos": [
    0,
    0,
    0,
    0,
    0,
    0
  ],
  "action_scale": 0.25,
  "clip_actions": 12,
  "obs_scales": {
    "ang_vel": 0.25,
    "dof_pos": 1,
    "dof_vel": 0.05
  },
  "command_scale": [
    2,
    2,
    0.25
  ],
  "obs_layout": [
    "base_ang_vel(body frame, rad/s) * 0.25            [0:3]",
    "projected_gravity(unit, body frame)               [3:6]",
    "commands (vx, vy, wz) * command_scale             [6:9]",
    "(dof_pos - default_dof_pos) * 1.0                 [9:15]",
    "dof_vel * 0.05                                    [15:21]",
    "previous raw action                               [21:27]",
    "sin, cos of 2 pi frac(freq * t), t = seconds since reset, freq 1.1 Hz [27:29]"
  ],
  "quat_convention": "wxyz; projected_gravity = R(q)^T @ [0, 0, -1]",
  "imu_link": "cross_body",
  "dof_vel_obs_clip": 18,
  "ang_vel_obs_clip": 34.9,
  "joint_limits_per_joint": {
    "waist_yaw": [
      -0.7,
      0.7
    ],
    "waist_pitch": [
      -0.7,
      0.7
    ],
    "hip_FR": [
      -2.62,
      1.25
    ],
    "hip_FL": [
      -2.62,
      1.25
    ],
    "hip_RL": [
      -1.35,
      2.62
    ],
    "hip_RR": [
      -1.35,
      2.62
    ]
  },
  "gait_clock": {
    "freq": 1.1
  },
  "control": {
    "type": "position PD on motor output shaft",
    "kp": 8,
    "kd": 0.5,
    "rate_hz": 50,
    "clamp_target_to_limit": true
  },
  "jump_command": {
    "vx": 0.6,
    "vy": 0.5,
    "wz": 0,
    "hold_s": 1,
    "note": "from standing with a zero command for ~1 s; any other command keeps the robot standing"
  }
}
